{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "e2e/**",
      "*.ts",
      "*.mjs",
      "*.json",
      "!pnpm-lock.yaml",
      "!test-*.json"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "overrides": [
    {
      "includes": [
        "next-env.d.ts",
        "src/components/ui/halftone-footer-artwork.json",
        "src/data/qatar-schools.json"
      ],
      "formatter": { "enabled": false }
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": { "noImportantStyles": "off" }
    }
  },
  "css": { "parser": { "tailwindDirectives": true } }
}
